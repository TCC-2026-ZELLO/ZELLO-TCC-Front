# Configuração do servidor web do frontend Zello.
# Variáveis substituídas na inicialização do contêiner (envsubst da imagem oficial):
#   API_UPSTREAM       URL interna do backend, ex.: https://zello-back.<ambiente>.azurecontainerapps.io
#   CSP_CONNECT_EXTRA  origens adicionais permitidas em connect-src (opcional)

server_tokens off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # v5.0.0-5.2.1 / 4.2.1: limite do corpo (uploads de até 5 MB + multipart).
    client_max_body_size 6m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    large_client_header_buffers 4 16k;

    # v5.0.0-3.5.3: só os métodos usados pela aplicação.
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    # v5.0.0-13.4.1: arquivos ocultos e metadados de controle de versão nunca
    # são servidos (.git, .env, .DS_Store etc.).
    location ~ /\. {
        return 404;
    }

    # API no mesmo site do frontend. Permite cookies SameSite=Strict com
    # prefixo __Host- (v5.0.0-3.3.1, 3.3.3) e dispensa CORS no navegador.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        # v5.0.0-4.1.3: valores de proxy enviados pelo cliente são descartados
        # ou recalculados; X-Real-IP do cliente nunca chega à API.
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }

    # O HTML da aplicação nunca é guardado em cache, para que atualizações de
    # segurança cheguem a todos imediatamente.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # v5.0.0-13.4.7: allowlist de extensões estáticas geradas pelo build.
    location ~* \.(?:js|css|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|webmanifest|txt)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Qualquer outra extensão (.map, .json, .bak, .sql, .env, .yml ...) é recusada.
    location ~* \.[A-Za-z0-9]+$ {
        return 404;
    }

    # Rotas da SPA.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
